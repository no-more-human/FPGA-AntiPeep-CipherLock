##============================================================
## 保险箱密码锁 引脚约束（Anlogic Design Constraint）
## 依据：硬木课堂 DMZ-EG4S20 官方板卡引脚示意图 & docs/EG4S20_Pinout.md
## 纯板载原生外设方案：板载 4x4 轻触按键矩阵、8 路 LED、4 位共阴数码管、
## 板载无源蜂鸣器、板载拨码开关 SW1/SW7、板载 CH340 Type-C UART 串口
##============================================================

## 50MHz 系统主时钟
set_pin_assignment	{ clk_50M }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; }

## 独立复位按键（KEY1/RSTn，低电平有效，加内部弱上拉保护）
set_pin_assignment	{ rst_n }	{ LOCATION = E3; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

## 8 个板载 LED（高电平点亮）
set_pin_assignment	{ led[0] }	{ LOCATION = B14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[1] }	{ LOCATION = B15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[2] }	{ LOCATION = B16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[3] }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[4] }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[5] }	{ LOCATION = E13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[6] }	{ LOCATION = E16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[7] }	{ LOCATION = F16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

## 板载 4x4 矩阵微动按键接口（16 颗白色轻触开关）
## 行输入（Row 0~3 -> E10, C10, F9, D9，配置内部上拉 PULLUP）
set_pin_assignment	{ key_row[0] }	{ LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ key_row[1] }	{ LOCATION = C10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ key_row[2] }	{ LOCATION = F9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ key_row[3] }	{ LOCATION = D9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

## 列扫描输出（Col 0~3 -> E11, D11, C11, F10，轮流输出低电平）
set_pin_assignment	{ key_col[0] }	{ LOCATION = E11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ key_col[1] }	{ LOCATION = D11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ key_col[2] }	{ LOCATION = C11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ key_col[3] }	{ LOCATION = F10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

## 板载 4 位共阴数码管段选（A~G, DP，高电平点亮）
set_pin_assignment	{ seg_out[0] }	{ LOCATION = A4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[1] }	{ LOCATION = A6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[2] }	{ LOCATION = B8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[3] }	{ LOCATION = E8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[4] }	{ LOCATION = A7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[5] }	{ LOCATION = B5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[6] }	{ LOCATION = A8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_out[7] }	{ LOCATION = C8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

## 板载 4 位共阴数码管位选（COM1~COM4，低电平有效选通）
set_pin_assignment	{ seg_cs[0] }	{ LOCATION = C9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_cs[1] }	{ LOCATION = B6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_cs[2] }	{ LOCATION = A5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_cs[3] }	{ LOCATION = A3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

## 板载无源蜂鸣器（PWM 驱动）
set_pin_assignment	{ buzzer_out }	{ LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

## 门磁状态模拟输入接口 (板载 SW1 拨动开关，引脚: A10)
set_pin_assignment	{ door_gpio }	{ LOCATION = A10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

## UART 串口通信与上位机/AI联动接口 (115200 8-N-1)
## 采用 DMZ-EG4S20 板载 Type-C 虚拟串口（板载 CH340，插 USB 线即用）
set_pin_assignment	{ uart_tx }	{ LOCATION = D12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ uart_rx }	{ LOCATION = F12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

## 遗忘密码应急恢复通道使能拨码 (SW7, 高电平使能 D 键输入 6 位恢复码)
set_pin_assignment	{ sw_recovery }	{ LOCATION = A14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
